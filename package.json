{
  "name": "digital-circuits-suite",
  "version": "2.1.0",
  "private": true,
  "description": "Digital Circuits Suite - Boolean Logic Solver, Circuits Simulator, and 7-Segment Display Simulator",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:web1": "node scripts/build.mjs web1",
    "build:web2": "node scripts/build.mjs web2",
    "build:web3": "node scripts/build.mjs web3",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:backend": "python3 -m pytest tests/backend -q",
    "check:shared": "node scripts/check-shared-sync.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.23.0",
    "typescript": "~5.5.4",
    "vite": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
